# Microsoft Foundry project endpoint
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Foundry account endpoint (without /api/projects/...)
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/

# Model deployment name in your Foundry project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Embedding model deployment (Lesson 06)
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Azure AI Search endpoint (Lesson 06)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Azure Storage connection string (Lesson 06)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Web IQ API key (Lesson 07) — get from https://webiq.microsoft.ai
WEBIQ_API_KEY=your-webiq-api-key-here
