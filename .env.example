# ─── Core (all lessons) ──────────────────────────────────────────────────────

# Microsoft Foundry project endpoint
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Model deployment name in your Foundry project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# ─── Lesson 04 — Toolbox ─────────────────────────────────────────────────────

# Name of the toolbox configured in your Foundry project
TOOLBOX_NAME=workshop-toolbox

# ─── Lesson 06 — Foundry IQ Knowledge Base ───────────────────────────────────
# Note: the Foundry account endpoint (model/embedding resource URL) is derived
# automatically from AZURE_AI_PROJECT_ENDPOINT — no separate var needed.

# Azure AI Search endpoint
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net

# Embedding model deployment (vectorizes documents and queries)
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large

# Storage account holding the source documents (blob knowledge source)
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account

# Full resource ID of the storage account (for managed-identity blob access)
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<account>

# ─── Lesson 07 — Web IQ ──────────────────────────────────────────────────────

# Web IQ API key — get from https://webiq.microsoft.ai
WEBIQ_API_KEY=your-webiq-api-key-here
